{
  "Routes": [
    {
      "DownstreamPathTemplate": "/api/auth/{everything}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 7160
        }
      ],
      "UpstreamPathTemplate": "/gateway/api/auth/{everything}",
      "UpstreamHttpMethod": [ "POST" ],

      "RateLimitOptions": {
        "EnableRateLimiting": true,
        "Period": "10s",
        "Limit": 2,
        "PeriodTimespan": 10
      }
    },

    {
      "DownstreamPathTemplate": "/api/users/{everything}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 7160
        }
      ],
      "UpstreamPathTemplate": "/gateway/api/users/{everything}",
      "UpstreamHttpMethod": [ "GET", "PUT", "DELETE" ],

      "RateLimitOptions": {
        "EnableRateLimiting": true,
        "Period": "15s",
        "Limit": 2,
        "PeriodTimespan": 10
      },

      "FileCacheOptions": {
        "TtlSeconds": 15
      },

      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer",
        "AllowedScopes": []
      }
    },

    {
      "DownstreamPathTemplate": "/api/users",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 7160
        }
      ],
      "UpstreamPathTemplate": "/gateway/api/users/{everything}",
      "UpstreamHttpMethod": [ "POST" ]
    },

    {
      "DownstreamPathTemplate": "/api/notifications/{everything}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 7276
        }
      ],
      "UpstreamPathTemplate": "/gateway/api/notifications/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ],

      "RateLimitOptions": {
        "EnableRateLimiting": true,
        "Period": "20s",
        "Limit": 5,
        "PeriodTimespan": 10
      },

      "FileCacheOptions": {
        "TtlSeconds": 15
      },

      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer",
        "AllowedScopes": []
      }
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "https://localhost:7210"
  },
  "Includes": [
    "authService.json",
    "userService.json",
    "notificationService.json"
  ]
}
