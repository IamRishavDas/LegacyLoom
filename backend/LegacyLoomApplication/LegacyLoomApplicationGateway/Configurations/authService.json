{
  "Routes": [
    {
      "DownstreamPathTemplate": "/api/auth/{everything}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 7160
        }
      ],
      "UpstreamPathTemplate": "/gateway/api/auth/{everything}",
      "UpstreamHttpMethod": [ "POST" ],

      "RateLimitOptions": {
        "EnableRateLimiting": true,
        "Period": "10s",
        "Limit": 2,
        "PeriodTimespan": 10
      },

      "FileCacheOptions": {
        "TtlSeconds": 60
      }
    }
  ]
}